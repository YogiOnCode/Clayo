<Window x:Class="CcxShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CcxShell"
        Title="C L A Y O"
        Height="820" Width="1280"
        MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource TerminalBg}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <!-- Title is spaced out because DWM renders it verbatim in the system caption font and
       colour: spacing is the only thing about that text we can influence, and five letters
       spaced read as a mark where the same five set tight read as a filename. It is the
       Alt-Tab and taskbar label too. The caption itself stays the system's, with the dark
       mode and acrylic applied in OnSourceInitialized. -->

  <Window.Resources>
    <local:BrushKeyConverter x:Key="BrushKey" />
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="310" MinWidth="240" MaxWidth="520" />
      <ColumnDefinition Width="7" />
      <ColumnDefinition Width="*" MinWidth="360" />
    </Grid.ColumnDefinitions>

    <!-- ============================ sidebar ============================ -->
    <Grid Grid.Column="0" Background="{StaticResource SurfaceBg}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="14,14,14,8">
        <TextBlock x:Name="CurrentFolderName"
                   Foreground="{StaticResource TextPrimary}"
                   FontSize="14" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="CurrentFolderPath"
                   Foreground="{StaticResource TextFaint}"
                   FontFamily="{StaticResource MonoFont}"
                   FontSize="10.5" Margin="0,2,0,0"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <!-- Search. The hint is a sibling TextBlock, toggled in code-behind — a
           converter for something this small is not worth the indirection. -->
      <Grid Grid.Row="1" Margin="14,0,14,6">
        <TextBox x:Name="Filter"
                 Style="{StaticResource SearchBox}"
                 TextChanged="Filter_TextChanged"
                 GotFocus="Filter_FocusChanged"
                 LostFocus="Filter_FocusChanged" />
        <TextBlock x:Name="SearchHint"
                   Text="Search sessions"
                   Foreground="{StaticResource TextFaint}"
                   FontSize="12"
                   Margin="9,0,0,0"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False" />
      </Grid>

      <!-- Group / sort, the Explorer idiom. -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0,10,4">
        <ComboBox x:Name="GroupBy"
                  Style="{StaticResource TinyCombo}"
                  ItemContainerStyle="{StaticResource TinyComboItem}"
                  SelectedIndex="0"
                  SelectionChanged="View_Changed">
          <ComboBoxItem Content="Group: Folder" />
          <ComboBoxItem Content="Group: None" />
        </ComboBox>
        <ComboBox x:Name="SortBy"
                  Style="{StaticResource TinyCombo}"
                  ItemContainerStyle="{StaticResource TinyComboItem}"
                  SelectedIndex="0"
                  Margin="4,0,0,0"
                  SelectionChanged="View_Changed">
          <ComboBoxItem Content="Newest" />
          <ComboBoxItem Content="Oldest" />
          <ComboBoxItem Content="Name" />
        </ComboBox>
      </StackPanel>

      <ListBox x:Name="Sessions" Grid.Row="3"
               Background="Transparent"
               BorderThickness="0"
               ItemContainerStyle="{StaticResource SessionItem}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.IsVirtualizing="False"
               SelectionChanged="Sessions_SelectionChanged"
               MouseDoubleClick="Sessions_DoubleClick"
               KeyDown="Sessions_KeyDown">

        <ListBox.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
        </ListBox.Resources>

        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open" Click="Open_Click" />
            <MenuItem Header="Rename" InputGestureText="F2" Click="Rename_Click" />
            <Separator />
            <MenuItem Header="Reset name" Click="ResetName_Click" />
          </ContextMenu>
        </ListBox.ContextMenu>

        <ListBox.GroupStyle>

          <!-- Level 0: Open / Today / Earlier. The first two start expanded; whatever you
               toggle is remembered in _sectionOpen, because the containers here are thrown
               away and rebuilt on every refresh. -->
          <GroupStyle>
            <GroupStyle.ContainerStyle>
              <Style TargetType="GroupItem">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                      <Expander x:Name="Ex"
                                Style="{StaticResource SectionExpander}"
                                Tag="{Binding Name}"
                                Loaded="Section_Loaded"
                                Expanded="Section_Toggled"
                                Collapsed="Section_Toggled">
                        <Expander.Header>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ItemCount}"
                                       Foreground="{StaticResource TextFaint}"
                                       FontSize="11" Margin="8,0,2,0" />
                          </Grid>
                        </Expander.Header>
                        <ItemsPresenter />
                      </Expander>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </GroupStyle.ContainerStyle>
          </GroupStyle>

          <!-- Level 1: folder. Only present when Group: Folder is selected. -->
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <Grid Margin="26,10,10,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                             Text="{Binding Name}"
                             Foreground="{StaticResource TextMuted}"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding ItemCount}"
                             Foreground="{StaticResource TextFaint}"
                             FontSize="11" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>

        </ListBox.GroupStyle>

        <ListBox.ItemTemplate>
          <DataTemplate>
            <!-- Indent is the branch depth: a session forked from another sits inside it. -->
            <Grid Margin="{Binding Indent}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Status light. Live sessions get a real colour; everything else a
                   near-invisible dot, so the eye lands only on what is running. -->
              <Ellipse Grid.Column="0"
                       Width="7" Height="7"
                       Fill="{Binding StatusBrush, Converter={StaticResource BrushKey}}"
                       VerticalAlignment="Top" Margin="0,4,0,0"
                       ToolTip="{Binding StatusText}" />

              <StackPanel Grid.Column="1">
                <!-- Marker as well as indent, so a branch is still recognisable when
                     sorting by name pulls it away from the session it came from. A Grid
                     rather than a StackPanel: the name has to keep trimming to width. -->
                <Grid Visibility="{Binding LabelVisibility}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                             Text="↳"
                             Visibility="{Binding BranchMarkVisibility}"
                             Foreground="{StaticResource TextFaint}"
                             FontSize="11" Margin="0,0,5,0"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Name}"
                             Foreground="{StaticResource TextPrimary}"
                             FontSize="12.5"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding Tip}" />
                </Grid>

                <!-- Rename box. Lives in the row so editing happens where you are looking. -->
                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding EditorVisibility}"
                         Style="{StaticResource RenameBox}"
                         Loaded="RenameBox_Loaded"
                         KeyDown="RenameBox_KeyDown"
                         LostFocus="RenameBox_LostFocus" />

                <TextBlock Text="{Binding Subtitle}"
                           Foreground="{StaticResource TextFaint}"
                           FontSize="10.5" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Footer tray: a hairline and a darker band, so the actions read as apart from the list. -->
      <Border Grid.Row="4" Background="#171B21"
              BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0">
      <DockPanel LastChildFill="False" Margin="14,12,14,14">
        <Button x:Name="NewButton" Content="New session" Tag="&#xE710;"
                Style="{StaticResource AccentButton}"
                ToolTip="Pick the folder to start in. Recent folders first."
                Click="NewSession_Click" />
        <Button x:Name="OpenButton" Content="Open" Tag="&#xE8B7;"
                Style="{StaticResource GhostButton}"
                Margin="8,0,0,0"
                ToolTip="Pick a file: a new session starts in its folder with the file ready at the prompt."
                Click="OpenFile_Click" />

        <!-- Folder picker for a new session. Opens upward: these buttons sit on the
             bottom edge of the sidebar. The gap above the button is the inner Border's
             margin rather than a VerticalOffset, which flips sign with Placement. -->
        <Popup x:Name="FolderPopup"
               PlacementTarget="{Binding ElementName=NewButton}"
               Placement="Top"
               AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
          <Border Background="{StaticResource RaisedBg}"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                  CornerRadius="5" Padding="4" Margin="0,0,0,6"
                  MinWidth="272" MaxWidth="420">
            <StackPanel>
              <TextBlock Text="Start a session in"
                         Foreground="{StaticResource TextFaint}"
                         FontSize="10.5" Margin="7,4,7,6" />

              <ListBox x:Name="RecentFolders"
                       Background="Transparent" BorderThickness="0"
                       MaxHeight="264"
                       ItemContainerStyle="{StaticResource FolderItem}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       SelectionChanged="RecentFolder_Selected">
                <ListBox.Resources>
                  <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}"
                                 Foreground="{StaticResource TextPrimary}"
                                 FontSize="12"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding FullPath}"
                                 Foreground="{StaticResource TextFaint}"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="10" Margin="0,1,0,0"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0"
                      Margin="4,5,4,0" />
              <Button Content="Browse for a folder…"
                      Style="{StaticResource QuietButton}"
                      Margin="4,7,4,2" HorizontalAlignment="Stretch"
                      Click="BrowseFolder_Click" />
            </StackPanel>
          </Border>
        </Popup>

        <!-- Closing the window only hides it, and the island stays away while Clayo is in
             front, so Quit has to be reachable from here too. Same items as the island's menu.
             Last in the panel so it is also last in the tab order. -->
        <Button x:Name="SettingsButton" DockPanel.Dock="Right"
                Content="&#xE713;"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                Style="{StaticResource GhostButton}"
                Width="30" Padding="0"
                ToolTip="Settings"
                AutomationProperties.Name="Settings"
                Click="Settings_Click">
          <Button.ContextMenu>
            <ContextMenu x:Name="SettingsMenu" Opened="SettingsMenu_Opened">
              <MenuItem Header="Settings…" InputGestureText="Ctrl+," Click="OpenSettings_Click" />
              <MenuItem x:Name="SettingsLoginItem" Header="Start at login" IsCheckable="True"
                        Click="SettingsLogin_Click" />
              <Separator />
              <MenuItem Header="Quit Clayo" Click="SettingsQuit_Click" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </DockPanel>
      </Border>
    </Grid>

    <GridSplitter Grid.Column="1"
                  Style="{StaticResource PaneSplitter}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext" />

    <!-- ========================== terminal side ========================= -->
    <Grid Grid.Column="2" Background="{StaticResource TerminalBg}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource SurfaceBg}"
              BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1">
        <Grid Margin="14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Ellipse x:Name="StatusDot" Grid.Column="0"
                   Width="7" Height="7"
                   Fill="{StaticResource Dormant}"
                   VerticalAlignment="Center" />

          <!-- The title, then the session's status strip; whatever is left stays empty. -->
          <DockPanel Grid.Column="1" LastChildFill="False">
            <TextBlock x:Name="PaneTitle"
                       Margin="10,13"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <local:StatusStripView x:Name="HeadStrip" AutomationProperties.Name="Session status" />
          </DockPanel>

          <Button x:Name="AttachButton" Grid.Column="2"
                  Content="Attach files…"
                  Style="{StaticResource QuietButton}"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0"
                  IsEnabled="False"
                  ToolTip="Puts the paths of the files you pick at the prompt, for Claude to read. Ctrl+V does the same for files copied in Explorer."
                  Click="Attach_Click" />

          <Button x:Name="ForkButton" Grid.Column="3"
                  Content="Branch from here"
                  Style="{StaticResource QuietButton}"
                  VerticalAlignment="Center"
                  IsEnabled="False"
                  ToolTip="Copies this conversation into a new session. The original is untouched."
                  Click="Fork_Click" />

          <Button x:Name="CloseButton" Grid.Column="4"
                  Content="✕"
                  Style="{StaticResource QuietButton}"
                  VerticalAlignment="Center"
                  Margin="8,0,0,0" Padding="9,4"
                  IsEnabled="False"
                  ToolTip="Close this session. It drops back into the list below Open."
                  Click="ClosePane_Click" />
        </Grid>
      </Border>

      <Grid x:Name="PaneHost" Grid.Row="1" />

      <TextBlock x:Name="EmptyState" Grid.Row="1"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{StaticResource TextFaint}"
                 FontSize="13"
                 TextAlignment="Center"
                 Text="Pick a session on the left, or start a new one." />

      <!-- Over both rows, header included. The terminals are WebView2 windows, which no WPF
           element can cover, so ShowSettings hides them while this is up. -->
      <local:SettingsPane x:Name="SettingsView" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
  </Grid>
</Window>
