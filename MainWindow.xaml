<Window x:Class="CcxShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CcxShell"
        Title="Clayo"
        Height="820" Width="1280"
        MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource TerminalBg}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.Resources>
    <local:BrushKeyConverter x:Key="BrushKey" />
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="310" MinWidth="240" MaxWidth="520" />
      <ColumnDefinition Width="7" />
      <ColumnDefinition Width="*" MinWidth="360" />
    </Grid.ColumnDefinitions>

    <!-- ============================ sidebar ============================ -->
    <Grid Grid.Column="0" Background="{StaticResource SurfaceBg}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="14,14,14,8">
        <TextBlock x:Name="CurrentFolderName"
                   Foreground="{StaticResource TextPrimary}"
                   FontSize="14" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="CurrentFolderPath"
                   Foreground="{StaticResource TextFaint}"
                   FontFamily="{StaticResource MonoFont}"
                   FontSize="10.5" Margin="0,2,0,0"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <!-- Search. The hint is a sibling TextBlock, toggled in code-behind — a
           converter for something this small is not worth the indirection. -->
      <Grid Grid.Row="1" Margin="14,0,14,6">
        <TextBox x:Name="Filter"
                 Style="{StaticResource SearchBox}"
                 TextChanged="Filter_TextChanged" />
        <TextBlock x:Name="SearchHint"
                   Text="Search sessions"
                   Foreground="{StaticResource TextFaint}"
                   FontSize="12"
                   Margin="9,0,0,0"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False" />
      </Grid>

      <!-- Group / sort, the Explorer idiom. -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0,10,4">
        <ComboBox x:Name="GroupBy"
                  Style="{StaticResource TinyCombo}"
                  ItemContainerStyle="{StaticResource TinyComboItem}"
                  SelectedIndex="0"
                  SelectionChanged="View_Changed">
          <ComboBoxItem Content="Group: Folder" />
          <ComboBoxItem Content="Group: None" />
        </ComboBox>
        <ComboBox x:Name="SortBy"
                  Style="{StaticResource TinyCombo}"
                  ItemContainerStyle="{StaticResource TinyComboItem}"
                  SelectedIndex="0"
                  Margin="4,0,0,0"
                  SelectionChanged="View_Changed">
          <ComboBoxItem Content="Newest" />
          <ComboBoxItem Content="Oldest" />
          <ComboBoxItem Content="Name" />
        </ComboBox>
      </StackPanel>

      <ListBox x:Name="Sessions" Grid.Row="3"
               Background="Transparent"
               BorderThickness="0"
               ItemContainerStyle="{StaticResource SessionItem}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.IsVirtualizing="False"
               SelectionChanged="Sessions_SelectionChanged"
               MouseDoubleClick="Sessions_DoubleClick"
               KeyDown="Sessions_KeyDown">

        <ListBox.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
        </ListBox.Resources>

        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open" Click="Open_Click" />
            <MenuItem Header="Rename                 F2" Click="Rename_Click" />
            <Separator />
            <MenuItem Header="Reset name" Click="ResetName_Click" />
          </ContextMenu>
        </ListBox.ContextMenu>

        <ListBox.GroupStyle>

          <!-- Level 0: Open / Today / Earlier. The first two stay expanded. -->
          <GroupStyle>
            <GroupStyle.ContainerStyle>
              <Style TargetType="GroupItem">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                      <Expander x:Name="Ex"
                                Style="{StaticResource SectionExpander}"
                                IsExpanded="False">
                        <Expander.Header>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ItemCount}"
                                       Foreground="{StaticResource TextFaint}"
                                       FontSize="11" Margin="8,0,2,0" />
                          </Grid>
                        </Expander.Header>
                        <ItemsPresenter />
                      </Expander>
                      <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Name}" Value="Open">
                          <Setter TargetName="Ex" Property="IsExpanded" Value="True" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Name}" Value="Today">
                          <Setter TargetName="Ex" Property="IsExpanded" Value="True" />
                        </DataTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </GroupStyle.ContainerStyle>
          </GroupStyle>

          <!-- Level 1: folder. Only present when Group: Folder is selected. -->
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <Grid Margin="26,10,10,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                             Text="{Binding Name}"
                             Foreground="{StaticResource TextMuted}"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding ItemCount}"
                             Foreground="{StaticResource TextFaint}"
                             FontSize="11" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>

        </ListBox.GroupStyle>

        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Status light. Live sessions get a real colour; everything else a
                   near-invisible dot, so the eye lands only on what is running. -->
              <Ellipse Grid.Column="0"
                       Width="7" Height="7"
                       Fill="{Binding StatusBrush, Converter={StaticResource BrushKey}}"
                       VerticalAlignment="Top" Margin="0,4,0,0"
                       ToolTip="{Binding StatusText}" />

              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}"
                           Visibility="{Binding LabelVisibility}"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="12.5"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Tip}" />

                <!-- Rename box. Lives in the row so editing happens where you are looking. -->
                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding EditorVisibility}"
                         Style="{StaticResource RenameBox}"
                         Loaded="RenameBox_Loaded"
                         KeyDown="RenameBox_KeyDown"
                         LostFocus="RenameBox_LostFocus" />

                <TextBlock Text="{Binding Subtitle}"
                           Foreground="{StaticResource TextFaint}"
                           FontSize="10.5" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="14,10,14,14">
        <Button x:Name="NewButton" Content="New session"
                Style="{StaticResource QuietButton}"
                Click="NewSession_Click" />
        <Button x:Name="ResumeButton" Content="Open"
                Style="{StaticResource QuietButton}"
                Margin="8,0,0,0" IsEnabled="False"
                ToolTip="Open the selected session. Double-click does the same. F2 renames."
                Click="Open_Click" />
      </StackPanel>
    </Grid>

    <GridSplitter Grid.Column="1"
                  Style="{StaticResource PaneSplitter}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext" />

    <!-- ========================== terminal side ========================= -->
    <Grid Grid.Column="2" Background="{StaticResource TerminalBg}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource SurfaceBg}"
              BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1">
        <Grid Margin="14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Ellipse x:Name="StatusDot" Grid.Column="0"
                   Width="7" Height="7"
                   Fill="{StaticResource Dormant}"
                   VerticalAlignment="Center" />

          <TextBlock x:Name="PaneTitle" Grid.Column="1"
                     Margin="10,13"
                     Foreground="{StaticResource TextMuted}"
                     FontSize="12"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />

          <Button x:Name="ForkButton" Grid.Column="2"
                  Content="Branch from here"
                  Style="{StaticResource QuietButton}"
                  VerticalAlignment="Center"
                  IsEnabled="False"
                  ToolTip="Copies this conversation into a new session. The original is untouched."
                  Click="Fork_Click" />

          <Button x:Name="CloseButton" Grid.Column="3"
                  Content="✕"
                  Style="{StaticResource QuietButton}"
                  VerticalAlignment="Center"
                  Margin="8,0,0,0" Padding="9,4"
                  IsEnabled="False"
                  ToolTip="Close this session. It drops back into the list below Open."
                  Click="ClosePane_Click" />
        </Grid>
      </Border>

      <Grid x:Name="PaneHost" Grid.Row="1" />

      <TextBlock x:Name="EmptyState" Grid.Row="1"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{StaticResource TextFaint}"
                 FontSize="13"
                 TextAlignment="Center"
                 Text="Pick a session on the left, or start a new one." />
    </Grid>
  </Grid>
</Window>
