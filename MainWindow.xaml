<Window x:Class="CcxShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ccx"
        Height="820" Width="1280"
        MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource TerminalBg}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="220" MaxWidth="520" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="*" MinWidth="360" />
    </Grid.ColumnDefinitions>

    <!-- ============================ sidebar ============================ -->
    <Grid Grid.Column="0" Background="{StaticResource SurfaceBg}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="14,14,14,8">
        <TextBlock x:Name="CurrentFolderName"
                   Foreground="{StaticResource TextPrimary}"
                   FontSize="14" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="CurrentFolderPath"
                   Foreground="{StaticResource TextFaint}"
                   FontFamily="{StaticResource MonoFont}"
                   FontSize="10.5" Margin="0,2,0,0"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <TextBox x:Name="Filter" Grid.Row="1"
               Style="{StaticResource SearchBox}"
               Margin="14,0,14,10"
               TextChanged="Filter_TextChanged" />

      <ListBox x:Name="Sessions" Grid.Row="2"
               Background="Transparent"
               BorderThickness="0"
               ItemContainerStyle="{StaticResource SessionItem}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               SelectionChanged="Sessions_SelectionChanged">

        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <Grid Margin="14,14,10,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                             Text="{Binding Name}"
                             Foreground="{StaticResource TextMuted}"
                             FontSize="11" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding ItemCount}"
                             Foreground="{StaticResource TextFaint}"
                             FontSize="11" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>

        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Preview}"
                         Foreground="{StaticResource TextPrimary}"
                         FontSize="12.5"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Preview}" />
              <TextBlock Text="{Binding Age}"
                         Foreground="{StaticResource TextFaint}"
                         FontSize="10.5" Margin="0,3,0,0" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="14,10,14,14">
        <Button x:Name="NewButton" Content="New session"
                Style="{StaticResource QuietButton}"
                Click="NewSession_Click" />
        <Button x:Name="ResumeButton" Content="Resume"
                Style="{StaticResource QuietButton}"
                Margin="8,0,0,0" IsEnabled="False"
                Click="Resume_Click" />
      </StackPanel>
    </Grid>

    <GridSplitter Grid.Column="1"
                  Width="1"
                  HorizontalAlignment="Stretch"
                  Background="{StaticResource Hairline}"
                  ResizeBehavior="PreviousAndNext" />

    <!-- ========================== terminal side ========================= -->
    <Grid Grid.Column="2" Background="{StaticResource TerminalBg}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource SurfaceBg}"
              BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1">
        <Grid Margin="14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Ellipse x:Name="StatusDot" Grid.Column="0"
                   Width="7" Height="7"
                   Fill="{StaticResource Idle}"
                   VerticalAlignment="Center" />

          <TextBlock x:Name="PaneTitle" Grid.Column="1"
                     Margin="10,13"
                     Foreground="{StaticResource TextMuted}"
                     FontSize="12"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />

          <Button x:Name="ForkButton" Grid.Column="2"
                  Content="Branch from here"
                  Style="{StaticResource QuietButton}"
                  VerticalAlignment="Center"
                  IsEnabled="False"
                  ToolTip="Copies this conversation into a new session. The original is untouched."
                  Click="Fork_Click" />
        </Grid>
      </Border>

      <Grid x:Name="PaneHost" Grid.Row="1" />

      <TextBlock x:Name="EmptyState" Grid.Row="1"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{StaticResource TextFaint}"
                 FontSize="13"
                 TextAlignment="Center"
                 Text="Pick a session on the left, or start a new one." />
    </Grid>
  </Grid>
</Window>
