<UserControl x:Class="CcxShell.UI.TerminalPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#14171C">
  <Grid>
    <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#14171C" />
    <TextBlock x:Name="LoadError" Visibility="Collapsed" Foreground="#ECEEF1" Margin="16"
               TextWrapping="Wrap" />
  </Grid>
</UserControl>
