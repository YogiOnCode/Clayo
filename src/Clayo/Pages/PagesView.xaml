<UserControl x:Class="CcxShell.PagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource TerminalBg}">

  <!-- Every page from every session (docs/PAGES.md, P5). It takes the terminal side's place,
       header included, as Settings does. -->
  <UserControl.Resources>
    <!-- A filter tick the size of the TinyCombo beside it: same text, same padding, so the
         row reads as one line. Tick is the Settings row's, a size larger. -->
    <Style x:Key="FilterTick" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Bd" CornerRadius="4" Padding="7,4" Background="Transparent">
              <StackPanel Orientation="Horizontal">
                <Border x:Name="Box" Width="12" Height="12" CornerRadius="3" BorderThickness="1"
                        BorderBrush="{StaticResource TextFaint}" VerticalAlignment="Center"
                        SnapsToDevicePixels="True">
                  <Path x:Name="Mark" Data="M2,5.6 L4.4,8 L9,3" Stroke="{StaticResource Clay}"
                        StrokeThickness="1.4" Visibility="Hidden" />
                </Border>
                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RaisedBg}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter TargetName="Box" Property="Background" Value="#24D27556" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Clay}" />
                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Background="{StaticResource SurfaceBg}"
            BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1">
      <DockPanel Margin="14,0" Height="44">
        <Button DockPanel.Dock="Right" Content="&#xE8BB;"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                Style="{StaticResource QuietButton}" Padding="9,6"
                VerticalAlignment="Center"
                ToolTip="Close (Esc)" AutomationProperties.Name="Close pages"
                Click="Close_Click" />
        <TextBlock Text="Pages" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
        <TextBlock x:Name="Count" Margin="8,0,0,0" FontSize="11"
                   Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Search, filters, sort. -->
    <DockPanel Grid.Row="1" Margin="14,10,14,6">
      <TextBox x:Name="Search" Width="220" Style="{StaticResource SearchBox}"
               AutomationProperties.Name="Search page titles"
               TextChanged="Filter_Changed" />
      <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
        <ComboBox x:Name="ProjectBy" Style="{StaticResource TinyCombo}" VerticalAlignment="Center"
                  ItemContainerStyle="{StaticResource TinyComboItem}"
                  SelectionChanged="Filter_Changed" />
        <ComboBox x:Name="AgentBy" Style="{StaticResource TinyCombo}" VerticalAlignment="Center" Margin="4,0,0,0"
                  ItemContainerStyle="{StaticResource TinyComboItem}"
                  SelectionChanged="Filter_Changed" />
        <ComboBox x:Name="SessionBy" Style="{StaticResource TinyCombo}" VerticalAlignment="Center" Margin="4,0,0,0"
                  ItemContainerStyle="{StaticResource TinyComboItem}"
                  SelectionChanged="Filter_Changed" />
        <CheckBox x:Name="SlidesOnly" Content="Slides" Style="{StaticResource FilterTick}"
                  Margin="6,0,0,0"
                  Click="Filter_Changed" />
        <CheckBox x:Name="SharedOnly" Content="Shared" Style="{StaticResource FilterTick}"
                  Margin="2,0,0,0"
                  Click="Filter_Changed" />
        <ComboBox x:Name="SortBy" Style="{StaticResource TinyCombo}" VerticalAlignment="Center" Margin="10,0,0,0"
                  ItemContainerStyle="{StaticResource TinyComboItem}"
                  SelectionChanged="Filter_Changed" />
      </StackPanel>
    </DockPanel>

    <ListBox x:Name="Cards" Grid.Row="2" Margin="8,0,8,8"
             Background="Transparent" BorderThickness="0"
             SelectionMode="Extended"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             MouseDoubleClick="Cards_DoubleClick"
             KeyDown="Cards_KeyDown"
             ContextMenuOpening="Cards_ContextMenuOpening">
      <ListBox.ContextMenu>
        <ContextMenu x:Name="CardMenu" />
      </ListBox.ContextMenu>
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Margin" Value="6" />
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Bd" Background="{StaticResource SurfaceBg}" CornerRadius="6"
                        BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="8">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource RaisedBg}" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Working}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Width="224">
            <Border Height="126" CornerRadius="3" Background="{StaticResource ChipBg}" ClipToBounds="True">
              <Grid>
                <TextBlock Text="{Binding Kind}" FontSize="10.5" Foreground="{StaticResource TextFaint}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{Binding Thumb}" Stretch="UniformToFill" VerticalAlignment="Top" />
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,1"
                        CornerRadius="3" Background="{StaticResource Clay}"
                        Visibility="{Binding SharedBadge}">
                  <TextBlock Text="Shared" FontSize="10" Foreground="White" />
                </Border>
              </Grid>
            </Border>
            <TextBlock Text="{Binding Title}" Margin="0,8,0,0" FontSize="12"
                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Sub}" Margin="0,2,0,0" FontSize="10.5"
                       Foreground="{StaticResource TextFaint}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock x:Name="Empty" Grid.Row="2"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Foreground="{StaticResource TextFaint}" FontSize="13"
               Visibility="Collapsed" />
  </Grid>
</UserControl>
