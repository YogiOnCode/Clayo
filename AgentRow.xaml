<UserControl x:Class="CcxShell.AgentRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- One agent in the setup window (design/setup/setup-prototype.html): badge, name over a
       grey line, the pill, then Use for a ready agent or Sign in for a signed-out one. A
       missing agent gets a second line with its install command, Install and Locate…. -->

  <Border Padding="18,14">
    <StackPanel>
      <DockPanel>
        <Border x:Name="Badge" Width="36" Height="36" CornerRadius="9" BorderThickness="1"
                SnapsToDevicePixels="True">
          <TextBlock x:Name="BadgeText" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <CheckBox x:Name="UseTick" DockPanel.Dock="Right" Style="{StaticResource Tick}"
                  Content="Use" FontSize="13" Margin="4,0,-10,0" VerticalAlignment="Center"
                  Click="UseTick_Click" />
        <Button x:Name="SignIn" DockPanel.Dock="Right" Content="Sign in" Margin="12,0,0,0"
                Style="{StaticResource GhostButton}" Background="{StaticResource Working}"
                BorderBrush="{StaticResource Working}" Foreground="#14171C" FontWeight="SemiBold"
                Click="SignIn_Click" />

        <Border x:Name="Pill" DockPanel.Dock="Right" CornerRadius="10" Padding="10,3"
                VerticalAlignment="Center" Margin="12,0,0,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="PillDot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock x:Name="PillText" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </Border>

        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="AgentName" FontSize="15" FontWeight="SemiBold" Foreground="#E6E9EE" />
          <TextBlock x:Name="Meta" FontSize="12.5" Foreground="{StaticResource MutedAA}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>

      <DockPanel x:Name="Fix" Margin="50,10,0,0">
        <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center">
          <Hyperlink x:Name="Locate" Foreground="#E39A7E" Click="Locate_Click">Locate…</Hyperlink>
        </TextBlock>
        <Button x:Name="Install" DockPanel.Dock="Right" Content="Install" Margin="10,0,0,0"
                Style="{StaticResource GhostButton}" BorderBrush="{StaticResource Clay}"
                Foreground="#E39A7E" FontWeight="SemiBold" Click="Install_Click" />
        <TextBlock x:Name="GetNode" DockPanel.Dock="Right" Margin="10,0,0,0" FontSize="12"
                   VerticalAlignment="Center">
          <Hyperlink NavigateUri="https://nodejs.org" Foreground="#E39A7E"
                     RequestNavigate="Link_RequestNavigate">Get Node.js first</Hyperlink>
        </TextBlock>
        <Border Background="{StaticResource TerminalBg}" BorderBrush="{StaticResource Hairline}"
                BorderThickness="1" CornerRadius="6" Padding="10,6">
          <TextBlock x:Name="InstallCommand" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     Foreground="{StaticResource MutedAA}" TextTrimming="CharacterEllipsis" />
        </Border>
      </DockPanel>
    </StackPanel>
  </Border>
</UserControl>
