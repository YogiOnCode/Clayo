<Application x:Class="CcxShell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>

    <!--
      The terminal fills most of the window and paints its own colours, so the
      chrome's job is to stay out of its way. Cool graphite, one warm accent
      reserved for "this session is doing something".
    -->
    <SolidColorBrush x:Key="TerminalBg"  Color="#14171C" />
    <SolidColorBrush x:Key="SurfaceBg"   Color="#1B1F26" />
    <SolidColorBrush x:Key="RaisedBg"    Color="#222731" />
    <SolidColorBrush x:Key="Hairline"    Color="#262C35" />
    <SolidColorBrush x:Key="TextPrimary" Color="#C8CDD6" />
    <SolidColorBrush x:Key="TextMuted"   Color="#7A828F" />
    <SolidColorBrush x:Key="TextFaint"   Color="#565E6B" />
    <SolidColorBrush x:Key="Working"     Color="#D4A24C" />
    <!-- Conventional reading, so the sidebar needs no legend: amber is in progress,
         blue is the ball in your court, green finished cleanly, red failed. Nothing
         but a real failure is allowed to be red. -->
    <SolidColorBrush x:Key="NeedsInput"  Color="#5AA9E6" />
    <SolidColorBrush x:Key="Done"        Color="#6BBF8A" />
    <SolidColorBrush x:Key="Failed"      Color="#D2605F" />
    <SolidColorBrush x:Key="Ended"       Color="#5A6472" />
    <SolidColorBrush x:Key="Dormant"     Color="#39404B" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="QuietButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RaisedBg}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource TerminalBg}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="CaretBrush" Value="{StaticResource Working}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sessions are a list, not a deck of cards: no per-item borders or shadows.
         Selection is a single rule in the left margin. -->
    <Style x:Key="SessionItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid x:Name="Row" Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Rectangle x:Name="Rule" Grid.Column="0" Fill="Transparent" />
              <ContentPresenter Grid.Column="1" Margin="34,7,10,7" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#1F242C" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#232935" />
                <Setter TargetName="Rule" Property="Fill" Value="{StaticResource Working}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>


    <!-- ===================== sidebar chrome ===================== -->

    <!-- Thin, no arrow buttons. The default WPF bar is too loud next to a terminal. -->
    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" Background="#333A45" CornerRadius="4" Margin="2,0" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#4A5462" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Section header: chevron + label + count. Used for Today / Earlier. -->
    <Style x:Key="SectionExpander" TargetType="Expander">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton x:Name="Head"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Focusable="False" Cursor="Hand">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" Padding="10,7,10,7">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="14" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="Chev" Grid.Column="0"
                              Data="M 0 0 L 4 4 L 0 8"
                              Stroke="{StaticResource TextFaint}" StrokeThickness="1.4"
                              VerticalAlignment="Center" HorizontalAlignment="Left"
                              RenderTransformOrigin="0.3,0.5" />
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#1F242C" />
                        <Setter TargetName="Chev" Property="Stroke" Value="{StaticResource TextMuted}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Chev" Property="RenderTransform">
                          <Setter.Value>
                            <RotateTransform Angle="90" />
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
                <ContentPresenter ContentSource="Header" />
              </ToggleButton>
              <ContentPresenter x:Name="Body" Visibility="Collapsed" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Group-by / sort-by pickers. Deliberately small; not the point of the screen. -->
    <Style x:Key="TinyCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Tog" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="7,4">
                      <StackPanel Orientation="Horizontal">
                        <ContentPresenter />
                        <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource TextFaint}"
                              StrokeThickness="1.3" Margin="6,2,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource RaisedBg}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
                <TextBlock Text="{TemplateBinding SelectionBoxItem}"
                           Foreground="{TemplateBinding Foreground}" FontSize="11" />
              </ToggleButton>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
                <Border Background="{StaticResource RaisedBg}" BorderBrush="{StaticResource Hairline}"
                        BorderThickness="1" CornerRadius="5" Padding="3" Margin="0,3,0,0">
                  <StackPanel IsItemsHost="True" />
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TinyComboItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2B313C" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Working}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>


    <!-- The divider you drag. A 1px splitter is correct on paper and unhittable in
         practice, so the band is 7px of transparent grab area with the hairline drawn
         down the middle of it. Transparent still hit-tests in WPF; null would not.
         Hover brightens the line, so the grab point announces itself instead of having
         to be hunted for. -->
    <Style x:Key="PaneSplitter" TargetType="GridSplitter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeWE" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
              <Rectangle x:Name="Line" Width="1" HorizontalAlignment="Center"
                         Fill="{StaticResource Hairline}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Line" Property="Width" Value="2" />
                <Setter TargetName="Line" Property="Fill" Value="{StaticResource Working}" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Line" Property="Width" Value="2" />
                <Setter TargetName="Line" Property="Fill" Value="{StaticResource Working}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Inline rename field. Sized to sit exactly where the label was, so the row
         does not jump when you start editing. -->
    <Style x:Key="RenameBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource TerminalBg}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="CaretBrush" Value="{StaticResource Working}" />
      <Setter Property="SelectionBrush" Value="#2F3947" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource Working}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
