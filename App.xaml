<Application x:Class="CcxShell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>

    <!--
      The terminal fills most of the window and paints its own colours, so the
      chrome's job is to stay out of its way. Cool graphite, one warm accent
      reserved for "this session is doing something".
    -->
    <SolidColorBrush x:Key="TerminalBg"  Color="#14171C" />
    <SolidColorBrush x:Key="SurfaceBg"   Color="#1B1F26" />
    <SolidColorBrush x:Key="RaisedBg"    Color="#222731" />
    <SolidColorBrush x:Key="Hairline"    Color="#262C35" />
    <SolidColorBrush x:Key="TextPrimary" Color="#C8CDD6" />
    <SolidColorBrush x:Key="TextMuted"   Color="#7A828F" />
    <SolidColorBrush x:Key="TextFaint"   Color="#565E6B" />
    <SolidColorBrush x:Key="Working"     Color="#D4A24C" />
    <SolidColorBrush x:Key="Idle"        Color="#4E5765" />
    <SolidColorBrush x:Key="Ended"       Color="#7A4F4F" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="QuietButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RaisedBg}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource TerminalBg}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="CaretBrush" Value="{StaticResource Working}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sessions are a list, not a deck of cards: no per-item borders or shadows.
         Selection is a single rule in the left margin. -->
    <Style x:Key="SessionItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid x:Name="Row" Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Rectangle x:Name="Rule" Grid.Column="0" Fill="Transparent" />
              <ContentPresenter Grid.Column="1" Margin="12,7,10,7" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#1F242C" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#232935" />
                <Setter TargetName="Rule" Property="Fill" Value="{StaticResource Working}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Application.Resources>
</Application>
