<Application x:Class="CcxShell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>

    <!--
      The terminal fills most of the window and paints its own colours, so the
      chrome's job is to stay out of its way. Cool graphite, one warm accent
      reserved for "this session is doing something".
    -->
    <SolidColorBrush x:Key="TerminalBg"  Color="#14171C" />
    <SolidColorBrush x:Key="SurfaceBg"   Color="#1B1F26" />
    <SolidColorBrush x:Key="RaisedBg"    Color="#222731" />
    <SolidColorBrush x:Key="Hairline"    Color="#262C35" />
    <SolidColorBrush x:Key="TextPrimary" Color="#C8CDD6" />
    <SolidColorBrush x:Key="TextMuted"   Color="#7A828F" />
    <SolidColorBrush x:Key="TextFaint"   Color="#565E6B" />
    <!-- TextMuted is 4.2:1 on SurfaceBg; settings and status strip text a step brighter clears 4.5:1. -->
    <SolidColorBrush x:Key="MutedAA"     Color="#8C94A1" />
    <SolidColorBrush x:Key="Working"     Color="#D4A24C" />
    <!-- Conventional reading, so the sidebar needs no legend: amber is in progress,
         blue is the ball in your court, green finished cleanly, red failed. Nothing
         but a real failure is allowed to be red. -->
    <SolidColorBrush x:Key="NeedsInput"  Color="#5AA9E6" />
    <SolidColorBrush x:Key="Done"        Color="#6BBF8A" />
    <SolidColorBrush x:Key="Failed"      Color="#D2605F" />
    <SolidColorBrush x:Key="Ended"       Color="#5A6472" />
    <SolidColorBrush x:Key="Dormant"     Color="#39404B" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="QuietButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RaisedBg}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Clay is the mascot's colour, the brand rather than a status, so it can mark the one
         primary action without competing with amber's "this session is doing something". -->
    <SolidColorBrush x:Key="Clay" Color="#D27556" />

    <!-- Keyboard focus only (the mouse never shows it). The default dotted rectangle is
         black, which on this chrome is no focus visual at all. -->
    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border Margin="-3" CornerRadius="9" BorderThickness="1"
                    BorderBrush="{StaticResource Clay}" SnapsToDevicePixels="True" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The sidebar's bottom row. One template for both looks: Background, BorderBrush and
         Foreground say which. Hover lays a wash of the button's own text colour over the face
         and brings the label to full strength, eased, so neither look ever jumps. A Segoe
         Fluent glyph in Tag sits before the label. -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#2E353F" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid SnapsToDevicePixels="True">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.16">
                      <VisualTransition.GeneratedEasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0.06" />
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0" />
                      <DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0.03" Duration="0" />
                      <DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Opacity" To="0.62" Duration="0" />
                    </Storyboard>
                  </VisualState>
                  <!-- Faint is already faint; dimming it again would lose the label. -->
                  <VisualState x:Name="Disabled">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>

              <Border x:Name="Bd" CornerRadius="6"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1" />
              <Border x:Name="Wash" CornerRadius="6" Opacity="0"
                      Background="{TemplateBinding Foreground}"
                      BorderBrush="{TemplateBinding Foreground}"
                      BorderThickness="1" />
              <!-- 0.75 keeps the resting label muted and still above 4.5:1 in both looks. -->
              <StackPanel x:Name="Face" Orientation="Horizontal" Opacity="0.75"
                          Margin="{TemplateBinding Padding}"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                           Margin="0,0,7,0" VerticalAlignment="Center" />
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="{x:Null}">
                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Hairline}" />
                <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- An on/off switch, from design/settings: an outlined track that fills with clay when on,
         its knob sliding across. A CheckBox underneath, so Space, clicks on its label and
         screen readers work as they do for any checkbox. -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="40" Height="20" Background="Transparent" SnapsToDevicePixels="True">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CheckStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.18">
                      <VisualTransition.GeneratedEasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Unchecked" />
                  <VisualState x:Name="Indeterminate" />
                  <VisualState x:Name="Checked">
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#D27556" Duration="0" />
                      <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#D27556" Duration="0" />
                      <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Ellipse.Fill).(SolidColorBrush.Color)" To="#1A1210" Duration="0" />
                      <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="20" Duration="0" />
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.16" />
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1.12" Duration="0" />
                      <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1.12" Duration="0" />
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed" />
                  <VisualState x:Name="Disabled">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                      <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>

              <Border x:Name="Track" CornerRadius="10" BorderThickness="1">
                <Border.Background><SolidColorBrush Color="Transparent" /></Border.Background>
                <Border.BorderBrush><SolidColorBrush Color="#8C94A1" /></Border.BorderBrush>
              </Border>
              <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5">
                <Ellipse.Fill><SolidColorBrush Color="#A9B0BB" /></Ellipse.Fill>
                <Ellipse.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform x:Name="Grow" />
                    <TranslateTransform x:Name="Slide" />
                  </TransformGroup>
                </Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A tick box, from design/settings: an outlined square that tints clay with a clay tick
         when on, and greys out with its label when disabled. -->
    <Style x:Key="Tick" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Bd" CornerRadius="6" Padding="10,8" Background="Transparent">
              <StackPanel Orientation="Horizontal">
                <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{StaticResource MutedAA}" Background="Transparent"
                        SnapsToDevicePixels="True">
                  <Path x:Name="Mark" Data="M2.6,6.85 L5.6,9.8 L11.4,4" Stroke="{StaticResource Clay}"
                        StrokeThickness="1.6" Visibility="Hidden" />
                </Border>
                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1E232B" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#24D27556" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Clay}" />
                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#6E7683" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                <Setter TargetName="Box" Property="Background" Value="Transparent" />
                <Setter TargetName="Box" Property="BorderBrush" Value="#3A414C" />
                <Setter TargetName="Mark" Property="Stroke" Value="#59616D" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The status strip (StatusStripView). Percentages take their band's colour; model, branch
         and effort stay neutral, since they are not a fullness. -->
    <SolidColorBrush x:Key="BandGreen"   Color="#6BBF8A" />
    <SolidColorBrush x:Key="BandYellow"  Color="#D9BE5C" />
    <SolidColorBrush x:Key="BandOrange"  Color="#E58C4E" />
    <SolidColorBrush x:Key="BandRed"     Color="#EC726C" />
    <SolidColorBrush x:Key="DiffAdded"   Color="#7CC596" />
    <SolidColorBrush x:Key="DiffDeleted" Color="#E08480" />
    <SolidColorBrush x:Key="StripRule"   Color="#2E353F" />
    <!-- Git's branch glyph on a 16 px grid: two commits on a line, one forking off. -->
    <Geometry x:Key="BranchGlyph">M6.1,3.5 A1.6,1.6 0 1 1 2.9,3.5 A1.6,1.6 0 1 1 6.1,3.5 Z M6.1,12.5 A1.6,1.6 0 1 1 2.9,12.5 A1.6,1.6 0 1 1 6.1,12.5 Z M13.1,5 A1.6,1.6 0 1 1 9.9,5 A1.6,1.6 0 1 1 13.1,5 Z M4.5,5.1 V10.9 M11.5,6.6 C11.5,9.6 4.5,8.6 4.5,10.9</Geometry>

    <!-- New session: the primary action stays in the graphite family. A filled, raised face
         and brighter label set it apart from the ghost buttons without a colour of its own. -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Background" Value="#2A303A" />
      <Setter Property="BorderBrush" Value="#3A424E" />
      <Setter Property="Foreground" Value="#E6E9EE" />
    </Style>

    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource TerminalBg}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="CaretBrush" Value="{StaticResource Working}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sessions are a list, not a deck of cards: no per-item borders or shadows.
         Selection is a single rule in the left margin. -->
    <Style x:Key="SessionItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid x:Name="Row" Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Rectangle x:Name="Rule" Grid.Column="0" Fill="Transparent" />
              <ContentPresenter Grid.Column="1" Margin="34,7,10,7" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#1F242C" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#232935" />
                <Setter TargetName="Rule" Property="Fill" Value="{StaticResource Working}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>


    <!-- ===================== sidebar chrome ===================== -->

    <!-- Thin, no arrow buttons. The default WPF bar is too loud next to a terminal. -->
    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" Background="#333A45" CornerRadius="4" Margin="2,0" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#4A5462" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Section header: chevron + label + count. Used for Today / Earlier. -->
    <Style x:Key="SectionExpander" TargetType="Expander">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton x:Name="Head"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Focusable="False" Cursor="Hand">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" Padding="10,7,10,7">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="14" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="Chev" Grid.Column="0"
                              Data="M 0 0 L 4 4 L 0 8"
                              Stroke="{StaticResource TextFaint}" StrokeThickness="1.4"
                              VerticalAlignment="Center" HorizontalAlignment="Left"
                              RenderTransformOrigin="0.3,0.5" />
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#1F242C" />
                        <Setter TargetName="Chev" Property="Stroke" Value="{StaticResource TextMuted}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Chev" Property="RenderTransform">
                          <Setter.Value>
                            <RotateTransform Angle="90" />
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
                <ContentPresenter ContentSource="Header" />
              </ToggleButton>
              <ContentPresenter x:Name="Body" Visibility="Collapsed" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Group-by / sort-by pickers. Deliberately small; not the point of the screen. -->
    <Style x:Key="TinyCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Tog" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="7,4">
                      <StackPanel Orientation="Horizontal">
                        <ContentPresenter />
                        <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource TextFaint}"
                              StrokeThickness="1.3" Margin="6,2,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource RaisedBg}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
                <TextBlock Text="{TemplateBinding SelectionBoxItem}"
                           Foreground="{TemplateBinding Foreground}" FontSize="11" />
              </ToggleButton>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
                <Border Background="{StaticResource RaisedBg}" BorderBrush="{StaticResource Hairline}"
                        BorderThickness="1" CornerRadius="5" Padding="3" Margin="0,3,0,0">
                  <StackPanel IsItemsHost="True" />
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TinyComboItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2B313C" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Working}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>


    <!-- Rows in the folder picker. Same hover colour as the combo items, so the two
         popups read as the same surface. No selected state: picking one closes the
         popup, so a persistent highlight would only ever flash. -->
    <Style x:Key="FolderItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2B313C" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The divider you drag. A 1px splitter is correct on paper and unhittable in
         practice, so the band is 7px of transparent grab area with the hairline drawn
         down the middle of it. Transparent still hit-tests in WPF; null would not.
         Hover brightens the line, so the grab point announces itself instead of having
         to be hunted for. -->
    <Style x:Key="PaneSplitter" TargetType="GridSplitter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeWE" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
              <Rectangle x:Name="Line" Width="1" HorizontalAlignment="Center"
                         Fill="{StaticResource Hairline}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Line" Property="Width" Value="2" />
                <Setter TargetName="Line" Property="Fill" Value="{StaticResource Working}" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Line" Property="Width" Value="2" />
                <Setter TargetName="Line" Property="Fill" Value="{StaticResource Working}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Inline rename field. Sized to sit exactly where the label was, so the row
         does not jump when you start editing. -->
    <Style x:Key="RenameBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource TerminalBg}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="CaretBrush" Value="{StaticResource Working}" />
      <Setter Property="SelectionBrush" Value="#2F3947" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource Working}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>


    <!-- ===================== menus ===================== -->

    <!-- Implicit, so the gear's, the island's and the session list's menus all pick it up.
         The surface is the popups' RaisedBg; Hairline would vanish against it, so the rim
         and the separators are a step brighter. -->
    <SolidColorBrush x:Key="MenuRim" Color="#323A46" />

    <!-- The panel under a context menu and a submenu, wrapped round their ItemsPresenter. The
         shadow is a layer of its own rather than an Effect on the panel, which would render the
         text through a bitmap and soften it. The margin is the shadow's room, weighted
         downward like the light. -->
    <ControlTemplate x:Key="MenuChrome" TargetType="ContentControl">
      <Grid Margin="8,4,8,12">
        <Border CornerRadius="8" Background="{StaticResource RaisedBg}">
          <Border.Effect>
            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.5" />
          </Border.Effect>
        </Border>
        <Border Background="{StaticResource RaisedBg}" BorderBrush="{StaticResource MenuRim}"
                BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="176"
                Grid.IsSharedSizeScope="True">
          <ContentPresenter />
        </Border>
      </Grid>
    </ControlTemplate>

    <Style TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Foreground" Value="#B4BAC4" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <ContentControl Template="{StaticResource MenuChrome}" Focusable="False">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
            </ContentControl>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Same hover colour family as the combo items. Keyboard navigation moves the highlight,
         so it doubles as the focus visual. Only the roles a context menu uses get real looks;
         a top-level header just drops its submenu below instead of beside. -->
    <Style TargetType="MenuItem">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="0,6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture" />
                  <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" ContentSource="Icon"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Path x:Name="Check" Data="M 0,4 L 3.5,7.5 L 10,1" Visibility="Collapsed"
                      Stroke="{StaticResource Clay}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                           Foreground="#959CA8" Margin="28,0,0,0" VerticalAlignment="Center" />
                <Path x:Name="Arrow" Grid.Column="3" Data="M 0 0 L 4 4 L 0 8" Visibility="Collapsed"
                      Stroke="{StaticResource TextMuted}" StrokeThickness="1.3"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Popup x:Name="PART_Popup" Grid.ColumnSpan="4" Placement="Right" HorizontalOffset="-2"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                  <ContentControl Template="{StaticResource MenuChrome}" Focusable="False">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                  </ContentControl>
                </Popup>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Role" Value="SubmenuHeader">
                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="Role" Value="TopLevelHeader">
                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2D343F" />
                <Setter Property="Foreground" Value="#E6E9EE" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                <Setter TargetName="Check" Property="Stroke" Value="{StaticResource TextFaint}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A menu sets this key on its separators itself, over any implicit Separator style. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Margin="10,4" Background="{StaticResource MenuRim}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
